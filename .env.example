# Indo-Voice-3 production environment
# Copy to .env and set values. Never commit .env.

INDO_CHECKPOINT=checkpoints/AERIS_main
INDO_AUDIO_WEIGHTS=
INDO_DEVICE=cpu

INDO_STT_PROVIDER=auto
INDO_TTS_PROVIDER=auto
INDO_WHISPER_SIZE=base
INDO_STT_DEVICE=cpu
# INDO_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

INDO_MAX_NEW_TOKENS=128
INDO_TEMPERATURE=0.7
INDO_TOP_P=0.9
INDO_PRIMARY_LANG=hi
INDO_HINGLISH=true

INDO_HOST=0.0.0.0
INDO_PORT=8000
INDO_CORS_ORIGINS=*
INDO_LOG_LEVEL=INFO
INDO_SAMPLE_RATE=16000
INDO_MAX_AUDIO_SEC=30
