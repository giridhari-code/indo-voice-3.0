# === Indo-Voice-3 Environment Variables ===
# Copy to .env and fill values. Never commit .env.

# Model dimensions
INDO_VOCAB_SIZE=32000
INDO_D_MODEL=768
INDO_D_K=64
INDO_D_V=64
INDO_N_SKILLS=8
INDO_TOP_K=2
INDO_K_MAX=4
INDO_DENDRITE_WINDOW=8
INDO_MAX_SEQ_LEN=2048
INDO_DROPOUT=0.1
INDO_TIE_EMBEDDINGS=true

# Safety
INDO_TRUNCATE_WINDOW=32
INDO_GATE_CAP=0.95
INDO_GATE_FLOOR=0.05
INDO_GATE_TARGET=0.35
INDO_MAX_MEM_NORM=10.0

# Ablation
INDO_USE_META=true
INDO_USE_NEUROMOD=true
INDO_USE_FAST_MEM=true
INDO_USE_SLOW_MEM=true

# Audio Encoder
INDO_SAMPLE_RATE=16000
INDO_N_MELS=80
INDO_AUDIO_LAYERS=6
INDO_AUDIO_DIM=512
INDO_AUDIO_HEADS=8

# Voice / Generation
INDO_MAX_NEW_TOKENS=256
INDO_TEMPERATURE=0.7
INDO_TOP_P=0.9
INDO_STREAM_CHUNK=4
INDO_PRIMARY_LANG=hi
INDO_HINGLISH=true
INDO_TTS_PROVIDER=none
